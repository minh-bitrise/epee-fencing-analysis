# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
dist/
build/
*.so

# Node. The root package.json is report tooling only and is not part of the
# project; the frontend's is, and must be committed or a fresh clone cannot
# build the interface at all.
node_modules/
/package-lock.json
/package.json

# OS
.DS_Store
Thumbs.db

# Video files (too large for git)
*.mp4
*.avi
*.mov
*.mkv

# Model weights (too large for git)
*.pt
*.pth
*.onnx
*.task

# Env / secrets
.env
*.env

# Misc
*.log
tmp/

# Machine-local editor and tooling configuration is excluded via
# .git/info/exclude rather than here, since it is specific to one developer's
# setup and not a property of the project.

# Runtime data produced by the web app: uploads, job records and their outputs.
# Kept out of git for the same reason as the prototype results - videos are large
# and these are per-machine, not part of the project.
code/var/

# The React build output. Generated by `npm run build` in code/frontend, so
# committing it would be committing a build artefact that goes stale silently.
code/backend/static/app/

# Prototype data (too large for git — keep locally)
code/prototype/results/
code/prototype/fencing_raw*
code/prototype/fencing_clip*.mp4
# Exception: deliverable demo video must be committed
!preliminary/prelim_demo_video.mp4

# Working notes, kept locally and out of the published repository. They are for
# the author and the assistant, not for a reader of the project.
/TODO.md
/MY_TASKS.md
/PROJECT_CONTEXT.md
/RESTORE_AFTER_DEMO.md
code/prototype/.demo_backup_*

# University course materials: the exam paper, the mock, the syllabus, the
# templates and the assignment briefs. They are the university's copyright, not
# this project's work, and an exam paper in particular has no business in a
# public repository. Kept locally, since the report's word caps and the exam
# prep are checked against them.
/uni_modules/
/final/EXAM_PREP.md
/final/feedback/

# Speaking scripts for the recorded submissions. They are notes to the author
# for delivery on the day, not deliverables, and a reader of the project gets
# nothing from them that the recordings do not already show.
/proposal/pitch_script.docx
/preliminary/prelim_demo_video_script.md
/preliminary/prelim_demo_video_script.docx
/final/DEMO_VIDEO_SCRIPT.md
